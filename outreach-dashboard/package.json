{
  "name": "outreach-dashboard",
  "version": "18.7.2",
  "description": "Flextail Gear Customer Automated Development System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node dashboard-local-server.js",
    "vercel-build": "node prepare-vercel-output.js",
    "check:handoff": "node --test ../tests/agent-handoff.test.js",
    "check:domain": "node --test ../tests/outreach-engine.test.js ../tests/outreach-analytics.test.js ../tests/autonomous-outreach-data.test.js ../tests/customer-event-ledger.test.js ../tests/system-readiness.test.js ../tests/sales-automation-core.test.js ../tests/command-center.test.js ../tests/email-channel.test.js ../tests/email-operations.test.js ../tests/alibaba-email-delivery.test.js ../tests/email-verification.test.js ../tests/browser-transport.test.js ../tests/glm-automation.test.js ../tests/smart-deploy.test.js ../tests/sync-autonomous-results.test.js",
    "check": "npm run check:domain && npm run check:handoff && node -c main.js && node -c browser-transport.js && node -c preload.js && node -c glm-service.js && node -c email-channel.js && node -c email-operations.js && node -c alibaba-email-delivery.js && node -c email-verification.js && node -c system-readiness.js && node -c sales-automation-core.js && node -c generate-system-readiness.js && node -c autoglm-bridge.js && node -c smart-deploy.js && node -c build-portable-app.js && node -c prepare-vercel-output.js && node -c service-worker.js && node -c dashboard-local-server.js && node -c daily-outreach-tasks.js && node -c outreach-engine.js && node -c outreach-analytics.js && node -c verified-profile-registry.js && node -c autonomous-outreach-data.js && node -c command-center.js && node -c daily-automation-runner.js && node -c generate-serial-run.js && node -c rebuild-followup-plan.js && node -c check-dashboard.js && node check-dashboard.js",
    "readiness:refresh": "node generate-system-readiness.js",
    "daily": "node daily-automation-runner.js --fix && node generate-system-readiness.js",
    "discover": "node google-lead-discovery-runner.js --limit=400",
    "discover:daily": "node google-lead-discovery-runner.js --limit=400 && node daily-automation-runner.js --fix && node generate-system-readiness.js",
    "daily:dry-run": "node daily-automation-runner.js",
    "daily:execute": "electron . --auto-run-daily",
    "daily:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install-daily-automation-task.ps1",
    "sync:github": "node sync-local-data-to-github.js",
    "sync:github:watch": "node sync-local-data-to-github.js --watch",
    "deploy:dry-run": "node smart-deploy.js --dry-run",
    "build": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis",
    "build:portable-folder": "node build-portable-app.js"
  },
  "author": "Flextail",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.flextail.outreach-dashboard",
    "productName": "Customer Development System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "browser-transport.js",
      "codex-chrome-driver.js",
      "preload.js",
      "glm-service.js",
      "email-channel.js",
      "alibaba-email-delivery.js",
      "email-verification.js",
      "sales-collateral.js",
      "autoglm-bridge.js",
      "build-portable-app.js",
      "dashboard-local-server.js",
      "daily-automation-runner.js",
      "google-lead-discovery-runner.js",
      "google-lead-discovery-latest.js",
      "daily-automation-execution-latest.js",
      "system-visibility-latest.json",
      "system-visibility-latest.js",
      "daily-automation-config.json",
      "daily-automation-latest.js",
      "github-sync/latest-status.js",
      "sync-local-data-to-github.js",
      "run-daily-customer-development.ps1",
      "install-daily-automation-task.ps1",
      "generate-serial-run.js",
      "rebuild-followup-plan.js",
      "check-dashboard.js",
      "index.html",
      "outreach-dashboard.html",
      "manifest.webmanifest",
      "service-worker.js",
      "icon.svg",
      "enhancements.css",
      "country-market-data.js",
      "country-market-protection.js",
      "daily-outreach-tasks.js",
      "outreach-engine.js",
      "outreach-analytics.js",
      "customer-event-ledger.js",
      "sales-automation-core.js",
      "system-readiness.js",
      "system-readiness-latest.json",
      "system-readiness-latest.js",
      "autonomous-outreach-results.js",
      "verified-profile-registry.js",
      "autonomous-outreach-data.js",
      "command-center.css",
      "command-center.js",
      "credentials.vault.json",
      "credentials.example.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.svg"
    },
    "portable": {
      "artifactName": "Customer-Development-System-v${version}-Portable.exe"
    }
  },
  "dependencies": {
    "imapflow": "^1.4.7",
    "nodemailer": "^9.0.3"
  }
}
