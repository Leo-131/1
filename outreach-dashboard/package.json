{
  "name": "outreach-dashboard",
  "version": "18.4.0",
  "description": "Flextail Gear Customer Automated Development System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node dashboard-local-server.js",
    "vercel-build": "node prepare-vercel-output.js",
    "check:handoff": "node --test ../tests/agent-handoff.test.js",
    "check": "npm run check:handoff && node -c main.js && node -c preload.js && node -c smart-deploy.js && node -c build-portable-app.js && node -c prepare-vercel-output.js && node -c service-worker.js && node -c dashboard-local-server.js && node -c daily-outreach-tasks.js && node -c generate-serial-run.js && node -c rebuild-followup-plan.js && node -c check-dashboard.js && node check-dashboard.js",
    "deploy:dry-run": "node smart-deploy.js --dry-run",
    "build": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis",
    "build:portable-folder": "node build-portable-app.js"
  },
  "author": "Flextail",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.flextail.outreach-dashboard",
    "productName": "Customer Development System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "build-portable-app.js",
      "dashboard-local-server.js",
      "generate-serial-run.js",
      "rebuild-followup-plan.js",
      "check-dashboard.js",
      "index.html",
      "outreach-dashboard.html",
      "manifest.webmanifest",
      "service-worker.js",
      "icon.svg",
      "enhancements.css",
      "country-market-data.js",
      "daily-outreach-tasks.js",
      "credentials.vault.json",
      "credentials.example.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.svg"
    },
    "portable": {
      "artifactName": "Customer-Development-System-v${version}-Portable.exe"
    }
  }
}
